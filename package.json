{
  "name": "bambu-monitor",
  "version": "1.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun run --title='Bambu LAN Monitor' --filter '*' dev",
    "dev:api": "NODE_ENV=development bun run --filter @bambu-monitor/api dev",
    "dev:ui": "NODE_ENV=development bun run --filter @bambu-monitor/ui dev",
    "lint": "biome check",
    "lint:write": "biome check --write",
    "format": "biome format --write .",
    "clean:modules": "bash -lc 'find . -type d -name node_modules -prune -print -exec rm -rf {} \\; && rm -f bun.lock'"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "elysia": "^1.4.28"
    }
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": ">=1.3.5"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,css,md,json}": [
      "bunx --bun biome check --write --unsafe"
    ]
  }
}
